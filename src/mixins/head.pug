mixin head(title)
  head
    meta(name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover")
    meta(charset='UTF-8')
    if csrfToken
      meta(name="csrf-token" content=csrfToken)
    title #{`${title} · reddont `}

    //- Icons. Their sources and the other logo versions are in branding/.
    //- sizes="32x32" rather than "any" lets Chrome pick the SVG.
    link(rel="icon" href="/favicon.ico" sizes="32x32")
    link(rel="icon" href="/favicon.svg" type="image/svg+xml")

    //- PWA Support. public/manifest.json uses the same theme color.
    link(rel="manifest" href="/manifest.json")
    meta(name="theme-color" content="#0e1113")
    meta(name="color-scheme" content="light dark")
    meta(name="mobile-web-app-capable" content="yes")
    meta(name="application-name" content="Reddont")

    //- Apple iOS PWA Support
    meta(name="apple-mobile-web-app-capable" content="yes")
    meta(name="apple-mobile-web-app-status-bar-style" content="black-translucent")
    meta(name="apple-mobile-web-app-title" content="Reddont")
    link(rel="apple-touch-icon" href="/apple-touch-icon.png")

    //- Service Worker Registration
    script.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/service-worker.js')
            .then((registration) => {
              console.log('Service Worker registered:', registration.scope);
            })
            .catch((error) => {
              console.error('Service Worker registration failed:', error);
            });
        });
      }

    //- Styles
    link(rel="stylesheet", href="/styles.css")
    //- Phones get reddit's mobile web layout, set in the system font like reddit.
    link(rel="stylesheet", href="/mobile.css" media="(max-width: 767px)")
    //- Everything wider gets old reddit as Reddit Enhancement Suite shows it.
    //- The query is the exact complement of mobile.css's, so no width
    //- (fractional zoom included) falls between the two.
    link(rel="stylesheet", href="/desktop.css" media="not all and (max-width: 767px)")
    if theme
      link(rel="stylesheet", href=`/${theme}.css`)
    script(src="/vendor/dash.all.min.js" defer)
    script.
      //- Initialize DASH before interaction so Reddit's separate audio and
      //- video streams are attached before a mobile browser enters native
      //- fullscreen. DASH/HLS errors restore the same proven MP4 used by
      //- the thumbnail.
      function isMobileVideoContext() {
        return window.matchMedia('(pointer: coarse)').matches
          || window.matchMedia('(max-width: 767px)').matches;
      }

      function playVideo(video) {
        var playPromise = video.play();
        if (playPromise && playPromise.catch) {
          playPromise.catch(function () {
            if (video.classList.contains('preview-video')) {
              video.dataset.previewPlayback = 'blocked';
            }
          });
        }
      }

      function destroyDashPlayer(video) {
        if (!video || !video.reddontDashPlayer) return;
        try {
          video.reddontDashPlayer.destroy();
        } catch (_error) {
          //- The media element is still reset below if dash.js has already
          //- released the player.
        }
        delete video.reddontDashPlayer;
      }

      function useFallbackVideo(video, fallbackUrl, resume) {
        destroyDashPlayer(video);
        video.dataset.playerInitialized = 'fallback';
        if (video.getAttribute('src') !== fallbackUrl) {
          video.src = fallbackUrl;
          video.load();
        }
        if (resume) playVideo(video);
      }

      function initVideoPlayer(video, resume) {
        if (!video) return;
        var hlsUrl = video.dataset.hlsUrl;
        var dashUrl = video.dataset.dashUrl;
        var fallbackUrl = video.dataset.fallbackUrl;

        if (video.dataset.playerInitialized) {
          if (resume) playVideo(video);
          return;
        }

        if (dashUrl && window.dashjs) {
          video.dataset.playerInitialized = 'dash';
          var player = dashjs.MediaPlayer().create();
          var fallbackActivated = false;
          var activateFallback = function () {
            if (!fallbackUrl || fallbackActivated) return;
            fallbackActivated = true;
            var shouldResume = resume || !video.paused;
            useFallbackVideo(video, fallbackUrl, shouldResume);
          };
          if (fallbackUrl && dashjs.MediaPlayer.events && dashjs.MediaPlayer.events.ERROR) {
            player.on(dashjs.MediaPlayer.events.ERROR, function () {
              if (fallbackActivated) return;
              activateFallback();
            });
          }
          try {
            video.reddontDashPlayer = player;
            player.initialize(video, dashUrl, !!resume);
          } catch (_error) {
            activateFallback();
          }
        } else if (hlsUrl && video.canPlayType('application/vnd.apple.mpegurl')) {
          video.dataset.playerInitialized = 'hls';
          if (fallbackUrl) {
            video.addEventListener('error', function () {
              var shouldResume = resume || !video.paused;
              useFallbackVideo(video, fallbackUrl, shouldResume);
            }, { once: true });
          }
          video.src = hlsUrl;
          video.load();
          if (resume) playVideo(video);
        } else if (fallbackUrl) {
          useFallbackVideo(video, fallbackUrl, resume);
        }
      }

      function releaseVideoPlayer(video) {
        if (!video) return;
        video.pause();
        if (!isMobileVideoContext()) return;

        destroyDashPlayer(video);
        video.removeAttribute('src');
        video.load();
        delete video.dataset.playerInitialized;
      }

      var previewVideoObserver;

      function isVideoInViewport(video) {
        var bounds = video.getBoundingClientRect();
        return bounds.bottom > 0
          && bounds.right > 0
          && bounds.top < window.innerHeight
          && bounds.left < window.innerWidth;
      }

      function playVideoPreview(video) {
        if (!video || video.dataset.previewSuspended) return;
        var previewUrl = video.dataset.previewSrc;
        video.muted = true;
        video.defaultMuted = true;
        if (!video.getAttribute('src') && previewUrl) {
          video.src = previewUrl;
          video.load();
        }
        delete video.dataset.previewPlayback;
        playVideo(video);
      }

      function pauseVideoPreview(video) {
        if (video) video.pause();
      }

      function initVideoPreviews(root) {
        if (!root || !root.querySelectorAll) return;
        var videos = root.querySelectorAll('video.preview-video');

        if ('IntersectionObserver' in window && !previewVideoObserver) {
          previewVideoObserver = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                playVideoPreview(entry.target);
              } else {
                pauseVideoPreview(entry.target);
              }
            });
          }, {
            rootMargin: '96px 0px',
            threshold: 0.15
          });
        }

        videos.forEach(function (video) {
          if (video.dataset.previewObserved) return;
          video.dataset.previewObserved = '1';
          video.muted = true;
          video.defaultMuted = true;
          video.addEventListener('error', function () {
            var alternateUrl = video.dataset.previewFallbackSrc;
            if (
              !alternateUrl ||
              video.dataset.previewFallbackUsed ||
              video.dataset.previewSuspended
            ) {
              return;
            }
            video.dataset.previewFallbackUsed = '1';
            video.dataset.previewSrc = alternateUrl;
            video.src = alternateUrl;
            video.load();
            if (isVideoInViewport(video)) playVideoPreview(video);
          });
          if (previewVideoObserver) {
            previewVideoObserver.observe(video);
          } else {
            playVideoPreview(video);
          }
        });
      }

      function findPostVideoPreview(detailsElement) {
        var post = detailsElement && detailsElement.closest('article.post');
        return post ? post.querySelector('.media-preview video.preview-video') : null;
      }

      function suspendPostVideoPreview(detailsElement) {
        var preview = findPostVideoPreview(detailsElement);
        if (!preview) return;
        preview.dataset.previewSuspended = '1';
        preview.pause();

        //- Android browsers can fail to allocate the expanded player while
        //- the thumbnail still owns a decoder for the same clip.
        if (isMobileVideoContext()) {
          preview.removeAttribute('src');
          preview.load();
        }
      }

      function resumePostVideoPreview(detailsElement) {
        var preview = findPostVideoPreview(detailsElement);
        if (!preview) return;
        delete preview.dataset.previewSuspended;
        if (isVideoInViewport(preview)) playVideoPreview(preview);
      }

      function sharePost(button) {
        var url = button.dataset.url;
        if (navigator.share) {
          navigator.share({ title: button.dataset.title, url: url }).catch(function () {});
          return;
        }
        if (navigator.clipboard) {
          navigator.clipboard.writeText(url).then(function () {
            button.classList.add('is-copied');
            setTimeout(function () { button.classList.remove('is-copied'); }, 1500);
          });
        }
      }

      async function toggleJoin(button) {
        var sub = button.dataset.joinSub;
        var thing = button.dataset.joined === '1' ? 'unsubscribe' : 'subscribe';
        var csrf = document.querySelector('meta[name="csrf-token"]');
        button.disabled = true;
        try {
          var response = await fetch('/' + thing, {
            method: 'POST',
            headers: {
              'X-CSRF-Token': csrf ? csrf.getAttribute('content') : '',
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ subreddit: sub }),
          });
          if (!response.ok) throw new Error('Failed to ' + thing);
          var joined = thing === 'subscribe';
          document.querySelectorAll('[data-join-sub]').forEach(function (other) {
            if (other.dataset.joinSub.toLowerCase() !== sub.toLowerCase()) return;
            other.dataset.joined = joined ? '1' : '0';
            other.classList.toggle('is-joined', joined);
            other.textContent = joined
              ? (other.dataset.joinedLabel || 'Joined')
              : (other.dataset.joinLabel || 'Join');
          });
          var legacy = document.getElementById('thinger_' + sub);
          if (legacy) legacy.innerText = joined ? 'unsubscribe' : 'subscribe';
        } catch (error) {
          console.error(error);
        } finally {
          button.disabled = false;
        }
      }

      //- Menus are <details>; close them on outside clicks like reddit's.
      document.addEventListener('click', function (event) {
        var menus = window.matchMedia('(max-width: 767px)').matches
          ? 'details.m-overflow[open], details.sort-details[open], details.view-details[open]'
          : 'details.dropdown[open]';
        document.querySelectorAll(menus).forEach(function (menu) {
          if (!menu.contains(event.target)) menu.open = false;
        });
      });

      //- Desktop comment buttons. old reddit's "hide child comments" folds
      //- each direct reply; the post's version folds every top-level comment.
      function setCommentsOpen(detailsList, button, open) {
        detailsList.forEach(function (details) { details.open = open; });
        button.textContent = button.textContent.replace(open ? 'show' : 'hide', open ? 'hide' : 'show');
      }

      function toggleChildComments(button) {
        var replies = button.closest('.comment-content').querySelectorAll(':scope > .replies > .comment > details');
        setCommentsOpen(replies, button, button.textContent.indexOf('show') === 0);
      }

      function toggleAllComments(button) {
        var comments = document.querySelectorAll('.comments-container > .comment > details');
        setCommentsOpen(comments, button, button.textContent.indexOf('show') === 0);
      }

      //- The comment page's expando button hides and shows the post's media.
      function togglePostMedia(button) {
        var media = document.getElementById(button.getAttribute('aria-controls'));
        if (!media) return;
        var open = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Collapse media' : 'Expand media');
        media.hidden = !open;
        if (!open) media.querySelectorAll('video').forEach(function (video) { video.pause(); });
      }

      //- RES-style gallery: one image at a time behind prev/next controls.
      function galleryStep(button, step) {
        var viewer = button.closest('.image-viewer');
        var items = viewer.querySelectorAll('.gallery-item');
        if (!items.length) return;
        var current = Array.prototype.findIndex.call(items, function (item) {
          return item.classList.contains('is-current');
        });
        var next = (Math.max(current, 0) + step + items.length) % items.length;
        items.forEach(function (item, index) {
          item.classList.toggle('is-current', index === next);
        });
        viewer.querySelector('.gallery-count').textContent = (next + 1) + ' of ' + items.length;
      }

      //- RES keyboard navigation on desktop: j/k select the next or previous
      //- post or comment, x or Enter toggles it, and c opens a post's comments.
      (function () {
        var phone = window.matchMedia('(max-width: 767px)');
        var thingSelector = '.post-container, .post-hero, .comment';

        function visibleThings() {
          return Array.prototype.filter.call(document.querySelectorAll(thingSelector), function (thing) {
            return thing.offsetParent !== null;
          });
        }

        function select(thing, scroll) {
          var current = document.querySelector('.res-selected');
          if (current === thing || !thing) return;
          if (current) current.classList.remove('res-selected');
          thing.classList.add('res-selected');
          if (!scroll) return;
          var bounds = thing.getBoundingClientRect();
          if (bounds.top < 0 || bounds.top > window.innerHeight * 0.8) {
            window.scrollBy({ top: bounds.top - window.innerHeight * 0.15, behavior: 'smooth' });
          }
        }

        function toggle(thing) {
          var expando = thing.querySelector(':scope > .expando-button');
          if (expando) return expando.click();
          if (thing.classList.contains('comment')) {
            var details = thing.querySelector(':scope > details');
            if (details) details.open = !details.open;
          }
        }

        document.addEventListener('keydown', function (event) {
          if (phone.matches || event.defaultPrevented) return;
          if (event.ctrlKey || event.metaKey || event.altKey) return;
          var target = event.target;
          if (!target.closest || target.closest('input, textarea, select, [contenteditable="true"]')) return;
          var things = visibleThings();
          if (!things.length) return;
          var current = document.querySelector('.res-selected');
          var index = things.indexOf(current);
          if (event.key === 'j' || event.key === 'k') {
            var next = event.key === 'j' ? index + 1 : index - 1;
            select(things[Math.min(Math.max(next, 0), things.length - 1)], true);
          } else if ((event.key === 'x' || event.key === 'Enter') && current) {
            //- Enter on a focused link or button keeps its own meaning.
            if (event.key === 'Enter' && target.closest('a, button, summary, [role="button"]')) return;
            toggle(current);
          } else if (event.key === 'c' && current) {
            var comments = current.querySelector('.buttons a.comments');
            if (comments) window.location.href = comments.href;
          } else {
            return;
          }
          event.preventDefault();
        });

        document.addEventListener('click', function (event) {
          if (phone.matches) return;
          var thing = event.target.closest && event.target.closest(thingSelector);
          if (thing) select(thing, false);
        });

        document.addEventListener('DOMContentLoaded', function () {
          if (!phone.matches) select(visibleThings()[0], false);
        });
      })();

      //- RES's "my subreddits" list: a filter, columns sorted by name or last
      //- visit, and visit times kept in this browser, as RES keeps them.
      (function () {
        var VISITS_KEY = 'reddont:lastVisited';
        var SORT_KEY = 'reddont:srListSort';

        function load(key, fallback) {
          try {
            return JSON.parse(localStorage.getItem(key)) || fallback;
          } catch (error) {
            return fallback;
          }
        }

        function save(key, value) {
          try {
            localStorage.setItem(key, JSON.stringify(value));
          } catch (error) {}
        }

        function timeAgo(time) {
          var seconds = Math.max(0, (Date.now() - time) / 1000);
          var units = [['year', 31536000], ['month', 2592000], ['day', 86400], ['hour', 3600], ['minute', 60]];
          for (var i = 0; i < units.length; i++) {
            var n = Math.floor(seconds / units[i][1]);
            if (n >= 1) return n + ' ' + units[i][0] + (n === 1 ? '' : 's') + ' ago';
          }
          return 'just now';
        }

        //- Names sort A to Z first; visits sort most recent first.
        function sortRows(table, sort) {
          var body = table.tBodies[0];
          var rows = Array.prototype.slice.call(body.querySelectorAll('tr[data-sub]'));
          rows.sort(function (a, b) {
            var byName = a.dataset.sub < b.dataset.sub ? -1 : a.dataset.sub > b.dataset.sub ? 1 : 0;
            if (sort.key !== 'visited') return byName * sort.dir;
            return ((Number(b.dataset.visited) || 0) - (Number(a.dataset.visited) || 0)) * sort.dir || byName;
          });
          rows.forEach(function (row) { body.appendChild(row); });
          table.querySelectorAll('th').forEach(function (th) {
            if (th.querySelector('button').dataset.sort !== sort.key) return th.removeAttribute('aria-sort');
            var ascending = sort.key === 'visited' ? sort.dir < 0 : sort.dir > 0;
            th.setAttribute('aria-sort', ascending ? 'ascending' : 'descending');
          });
        }

        document.addEventListener('DOMContentLoaded', function () {
          var area = document.getElementById('sr-header-area');
          if (!area) return;
          if (area.dataset.subreddit) {
            var visits = load(VISITS_KEY, {});
            visits[area.dataset.subreddit.toLowerCase()] = Date.now();
            save(VISITS_KEY, visits);
          }

          var menu = area.querySelector('.sr-dropdown');
          var table = menu.querySelector('.sr-list-table');
          var filter = menu.querySelector('.sr-list-filter');
          var sort = load(SORT_KEY, null);
          if (!sort || (sort.key !== 'name' && sort.key !== 'visited') || Math.abs(sort.dir) !== 1) {
            sort = { key: 'name', dir: 1 };
          }

          menu.addEventListener('toggle', function () {
            if (!menu.open) return;
            var visits = load(VISITS_KEY, {});
            table.querySelectorAll('tr[data-sub]').forEach(function (row) {
              var time = visits[row.dataset.sub];
              var cell = row.querySelector('.sr-visited');
              row.dataset.visited = time || '';
              cell.textContent = time ? timeAgo(time) : 'N/A';
              cell.classList.toggle('is-never', !time);
            });
            sortRows(table, sort);
            filter.focus();
          });

          table.tHead.addEventListener('click', function (event) {
            var button = event.target.closest('button[data-sort]');
            if (!button) return;
            var key = button.dataset.sort;
            sort = { key: key, dir: sort.key === key ? -sort.dir : 1 };
            save(SORT_KEY, sort);
            sortRows(table, sort);
          });

          filter.addEventListener('input', function () {
            var text = filter.value.trim().toLowerCase();
            table.querySelectorAll('tr[data-sub]').forEach(function (row) {
              row.hidden = row.dataset.sub.indexOf(text) === -1;
            });
          });

          //- Enter opens the first match; Escape closes the menu.
          filter.addEventListener('keydown', function (event) {
            if (event.key !== 'Enter') return;
            var first = table.querySelector('tr[data-sub]:not([hidden]) a');
            if (first) window.location.href = first.href;
            event.preventDefault();
          });

          menu.addEventListener('keydown', function (event) {
            if (event.key !== 'Escape') return;
            menu.open = false;
            menu.querySelector('summary').focus();
            event.preventDefault();
          });
        });
      })();

      document.addEventListener('DOMContentLoaded', function () {
        initVideoPreviews(document);

        document.addEventListener('visibilitychange', function () {
          document.querySelectorAll('video.preview-video').forEach(function (video) {
            if (document.hidden || !isVideoInViewport(video)) {
              pauseVideoPreview(video);
            } else {
              playVideoPreview(video);
            }
          });
        });
      });
