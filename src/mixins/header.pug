include icons
//- page describes the current page to the desktop header:
//- { name, href, current, subreddit, tabs: [{ label, href, selected }] }.
//- name and tabs become old reddit's page name and tab menu; current
//- highlights the matching link in the subreddit bar. subreddit, set on a
//- single community's pages, counts as a visit in the "my subreddits" list.
mixin header(user, page)
  - var viewQuery = 'view=' + (query && query.view ? query.view : 'compact')
  - var headerPage = page || {}
  - var navSubs = user && typeof navSubscriptions === 'function' ? navSubscriptions() : []
  - var srLinks = [['home', '/'], ['popular', '/r/popular'], ['all', '/r/all'], ['subs', '/subs'], ['search', '/search']]
  header.header
    if user
      div#sr-header-area.d-only(data-subreddit=headerPage.subreddit)
        //- RES's subreddit list; head.pug wires up the filter, sorting, and visit times.
        details.dropdown.sr-dropdown
          summary my subreddits
          div.drop-choices.sr-list
            div.sr-list-head
              input.sr-list-filter(type="search" placeholder="Filter subreddits..." aria-label="Filter subreddits" autocomplete="off" spellcheck="false")
              a.sr-list-all(href=`/subs?${viewQuery}`) View all »
            table.sr-list-table
              thead
                tr
                  th(aria-sort="ascending")
                    button(type="button" data-sort="name") subreddit
                  th
                    button(type="button" data-sort="visited") last visited
              tbody
                each sub in navSubs
                  tr(data-sub=sub.toLowerCase())
                    td
                      a(href=`/r/${sub}?${viewQuery}`) #{sub}
                    td.sr-visited N/A
                else
                  tr
                    td.sr-list-empty(colspan="2") no subscriptions yet
        ul.sr-bar
          each link in srLinks
            li
              a(href=`${link[1]}?${viewQuery}` class=(headerPage.current === link[0] ? 'selected' : false)) #{link[0]}
        if navSubs.length
          ul.sr-bar.sr-bar-subs
            each sub in navSubs
              li
                a(href=`/r/${sub}?${viewQuery}` class=(headerPage.current === sub.toLowerCase() ? 'selected' : false)) #{sub}
        a#sr-more-link(href=`/subs?${viewQuery}`) edit »
    details.m-drawer.m-only
      summary.m-icon-btn(aria-label="Open navigation")
        +icon("menu")
      div.m-drawer-scrim(onclick="this.closest('details').open = false")
      nav.m-drawer-panel(aria-label="Navigation")
        a.m-drawer-item(href=`/?${viewQuery}`)
          +icon("home")
          span Home
        a.m-drawer-item(href=`/r/popular?${viewQuery}`)
          +icon("popular")
          span Popular
        a.m-drawer-item(href=`/r/all?${viewQuery}`)
          +icon("all")
          span All
        hr.m-drawer-rule
        a.m-drawer-item(href=`/subs?${viewQuery}`)
          +icon("communities")
          span Subscriptions
        a.m-drawer-item(href=`/search?${viewQuery}`)
          +icon("search")
          span Search
        if user
          hr.m-drawer-rule
          a.m-drawer-item(href=`/dashboard?${viewQuery}`)
            +icon("user")
            span #{user.username}
          a.m-drawer-item(href='/logout')
            +icon("logout")
            span Log out
    a.brand(href=`/?${viewQuery}` aria-label="Reddont home")
      span.brand-mark(aria-hidden="true") R
      span.brand-name reddont
    if headerPage.name
      span.pagename.d-only
        a(href=headerPage.href) #{headerPage.name}
    if headerPage.tabs && headerPage.tabs.length
      ul.tabmenu.d-only
        each tab in headerPage.tabs
          li(class=(tab.selected ? 'selected' : false))
            a(href=tab.href) #{tab.label}
    if user
      div.header-item.account-nav
        a.account-link(href=`/dashboard?${viewQuery}`) #{user.username}
        span.separator.d-only(aria-hidden="true") |
        a.d-only(href=`/dashboard?${viewQuery}`) preferences
        span.separator.d-only(aria-hidden="true") |
        a.logout-link(href='/logout') logout
    else
      div.header-item.account-nav
        a(href=`/login`) login
    div.m-header-actions.m-only
      a.m-icon-btn(href=`/search?${viewQuery}` aria-label="Search")
        +icon("search")
      details.m-overflow.m-header-menu
        summary.m-icon-btn(aria-label="Account menu")
          +icon("overflow")
        div.m-menu
          if user
            a.m-menu-item(href=`/dashboard?${viewQuery}`)
              +icon("user")
              span #{user.username}
            a.m-menu-item(href=`/subs?${viewQuery}`)
              +icon("communities")
              span Subscriptions
            a.m-menu-item(href='/logout')
              +icon("logout")
              span Log out
          else
            a.m-menu-item(href='/login')
              +icon("user")
              span Log in
